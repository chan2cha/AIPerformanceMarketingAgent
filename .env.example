# Local Docker Compose defaults only. Copy to .env to override locally.
POSTGRES_DB=performance_marketing
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://app:local-development-only@postgres:5432/performance_marketing

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Subscription billing. Local uses fake activation without charging a card.
# Production must use Stripe, enable enforcement, and inject secrets into API only.
BILLING_PROVIDER=fake
BILLING_ENFORCEMENT_ENABLED=false
BILLING_MONTHLY_PRICE_USD=40.00
BILLING_MONTHLY_CREDIT_USD=15.00
BILLING_ANALYSIS_LIMIT=200
BILLING_COLLECTION_RUN_LIMIT=50
BILLING_BRAND_LIMIT=1
BILLING_COMPETITOR_LIMIT=5
BILLING_ANALYSIS_RESERVATION_USD=0.05
BILLING_COLLECTION_RESERVATION_USD=0.25
BILLING_SUCCESS_URL=http://localhost:3000/?billing=success
BILLING_CANCEL_URL=http://localhost:3000/?billing=cancelled
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APIFY_CONFIGURED=false
OPENAI_CONFIGURED=false

# Keep `fake` for offline/local use. Set `openai` only in the worker environment.
AI_PROVIDER=fake
AI_JOB_MAX_RETRIES=2
AI_JOB_RETRY_DELAY_SECONDS=1
# `fake` is deterministic local data. `apify` requires contract approval and a Worker-only token.
AD_LIBRARY_PROVIDER=fake
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_META_ACTOR_ID=apify~facebook-ads-scraper
APIFY_TIKTOK_ACTOR_ID=khadinakbar~tiktok-ads-scraper
APIFY_TIMEOUT_SECONDS=120
APIFY_MAX_ITEMS_PER_SYNC=25
APIFY_MAX_CHARGE_USD_PER_SYNC=0.25
APIFY_META_MAX_ITEMS_PER_SYNC=25
APIFY_META_MAX_CHARGE_USD_PER_SYNC=0.25
APIFY_TIKTOK_PERIOD_DAYS=30
COLLECTION_JOB_MAX_RETRIES=2
COLLECTION_JOB_RETRY_DELAY_SECONDS=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication: dev accepts `Authorization: Bearer dev:<subject>`.
# Set AUTH_MODE=supabase and SUPABASE_URL for verified Supabase JWTs.
APP_ENV=local
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
